APP_NAME="Bank Soal TKA"
APP_ENV=production

# =========================================================
# PENTING: Ganti APP_KEY dengan hasil: php artisan key:generate --show
# =========================================================
APP_KEY=

# Set ke false di production untuk keamanan
APP_DEBUG=false

# Ganti dengan URL domain InfinityFree Anda
APP_URL=https://your-domain.infinityfreeapp.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Di production gunakan 'error' agar log tidak penuh
LOG_LEVEL=error

# =========================================================
# DATABASE — Isi sesuai panel InfinityFree
# =========================================================
DB_CONNECTION=mysql
DB_HOST=sql.infinityfree.com
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# =========================================================
# SESSION — Gunakan 'file' (InfinityFree tidak punya Redis)
# =========================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# =========================================================
# QUEUE — Gunakan 'sync' (InfinityFree tidak punya Supervisor/Worker)
# Semua job akan dijalankan secara synchronous (langsung)
# =========================================================
QUEUE_CONNECTION=sync

# =========================================================
# CACHE — Gunakan 'file' (InfinityFree tidak punya Redis/Memcached)
# File cache tersimpan di storage/framework/cache/data/
# =========================================================
CACHE_STORE=file

# Redis tidak tersedia di InfinityFree — biarkan default
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================
# MAIL — Gunakan SMTP provider seperti Mailtrap / Brevo
# InfinityFree memblokir koneksi mail langsung
# =========================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
